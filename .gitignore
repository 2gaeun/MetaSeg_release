# Local datasets and inference outputs (including CSV/manifests).
/samples/
/outputs/
/backups/

# Model binaries and exported Docker images stay local.
/weights/**/*.pth
/weights/**/*.pt
/weights/**/*.ckpt
/weights/**/*.safetensors
/docker/*.tar
/docker/*.tar.gz
/docker/*.partial*

# Machine-specific bundle inventory; includes local datasets/artifacts.
/assets*.json

# Python build/cache files.
**/__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
/src/build/
/.venv/

# User images/results must never be uploaded.
/input/*
!/input/series.csv
!/input/.gitkeep
/output/*
!/output/.gitkeep
# Local research and historical files are outside this release.
/tests/
/tools/
/weights/**/trainer_source/
/weights/segmentation_123195/
/weights/**/provenance.json
/weights/da_export.json
/HANDOFF.md
/README_v1.md
/README_v2.md
